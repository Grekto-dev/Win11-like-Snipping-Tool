[Desktop Entry]
Type=Application
Name=Snipping Tool
GenericName=Screenshots and screen recording
GenericName[pt_BR]=Capturas e gravações de tela
Comment=Screenshots, annotation, text extraction and screen recording (Windows 11 style)
Comment[pt_BR]=Capturas e gravações de tela com marcação (estilo Windows 11)
Exec=captura %f
Icon=captura
Terminal=false
Categories=Utility;Graphics;
Keywords=screenshot;screen capture;snip;ocr;record;
MimeType=image/png;image/jpeg;image/bmp;
StartupWMClass=captura
Actions=Snip;Ocr;Color;

[Desktop Action Snip]
Name=New snip
Name[pt_BR]=Nova captura
Exec=captura --snip

[Desktop Action Ocr]
Name=Text extractor
Name[pt_BR]=Extrator de Texto
Exec=captura --ocr

[Desktop Action Color]
Name=Color picker
Name[pt_BR]=Seletor de cores
Exec=captura --color
